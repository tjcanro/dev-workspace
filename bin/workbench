#!/usr/bin/env python3
"""Install and validate the dev-workspace configuration."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import py_compile
import re
import shutil
import string
import subprocess
import sys
import tomllib


ROOT = Path(__file__).resolve().parent.parent
DEFAULT_PROFILE = ROOT / "profiles" / "local.toml"
EXAMPLE_PROFILE = ROOT / "profiles" / "example.toml"
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{1,62}[a-z0-9]$")
sys.path.insert(0, str(ROOT / "lib"))
import workspace_remote

GENERATED_HEADER = "# Generated by dev-workspace. Edit the template/profile instead.\n"


class WorkbenchError(RuntimeError):
    pass


def load_toml(path: Path) -> dict:
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except FileNotFoundError as exc:
        raise WorkbenchError(f"missing configuration: {path}") from exc
    except tomllib.TOMLDecodeError as exc:
        raise WorkbenchError(f"invalid TOML in {path}: {exc}") from exc


def expand_path(value: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


def selected_profile(path: str | None) -> Path:
    if path:
        return expand_path(path)
    if DEFAULT_PROFILE.exists():
        return DEFAULT_PROFILE
    return EXAMPLE_PROFILE


def profile_roots(profile: dict) -> list[Path]:
    roots = [ROOT]
    for raw_path in profile.get("overlays", {}).get("paths", []):
        root = expand_path(raw_path)
        if not root.is_dir():
            raise WorkbenchError(f"overlay does not exist: {root}")
        roots.append(root)
    return roots


def profile_skill_paths(profile: dict) -> list[Path]:
    paths: list[Path] = []
    for raw_path in profile.get("skills", {}).get("paths", []):
        path = expand_path(raw_path)
        if not (path / "SKILL.md").is_file():
            raise WorkbenchError(f"external skill is missing SKILL.md: {path}")
        paths.append(path)
    return paths


def parse_frontmatter(path: Path) -> tuple[dict[str, str], str]:
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        raise WorkbenchError(f"missing YAML frontmatter: {path}")
    try:
        end = lines.index("---", 1)
    except ValueError as exc:
        raise WorkbenchError(f"unterminated YAML frontmatter: {path}") from exc

    metadata: dict[str, str] = {}
    index = 1
    while index < end:
        line = lines[index]
        if not line.strip() or line.lstrip().startswith("#"):
            index += 1
            continue
        match = re.match(r"^([A-Za-z][A-Za-z0-9_-]*):(?:\s*(.*))?$", line)
        if not match:
            raise WorkbenchError(f"unsupported frontmatter line in {path}: {line}")
        key, value = match.group(1), (match.group(2) or "").strip()
        if value in {">", ">-", "|", "|-"}:
            chunks: list[str] = []
            index += 1
            while index < end and (lines[index].startswith(" ") or not lines[index].strip()):
                chunks.append(lines[index].strip())
                index += 1
            metadata[key] = " ".join(chunk for chunk in chunks if chunk)
            continue
        metadata[key] = value.strip('"\'')
        index += 1

    body = "\n".join(lines[end + 1 :]).strip() + "\n"
    return metadata, body


def discover_roles(roots: list[Path]) -> dict[str, Path]:
    roles: dict[str, Path] = {}
    for root in roots:
        role_dir = root / "agents" / "roles"
        if not role_dir.is_dir():
            continue
        for path in sorted(role_dir.glob("*.md")):
            metadata, _ = parse_frontmatter(path)
            name = metadata.get("name", "")
            if not name:
                raise WorkbenchError(f"agent role has no name: {path}")
            if name in roles:
                raise WorkbenchError(f"duplicate agent role {name}: {roles[name]} and {path}")
            roles[name] = path
    return roles


def discover_skills(roots: list[Path], external_paths: list[Path] | None = None) -> dict[str, Path]:
    skills: dict[str, Path] = {}
    directories: list[Path] = []
    for root in roots:
        skill_root = root / "skills"
        if skill_root.is_dir():
            directories.extend(sorted(path for path in skill_root.iterdir() if path.is_dir()))
    directories.extend(external_paths or [])

    for directory in directories:
        entrypoint = directory / "SKILL.md"
        if not entrypoint.is_file():
            raise WorkbenchError(f"skill is missing SKILL.md: {directory}")
        metadata, _ = parse_frontmatter(entrypoint)
        name = metadata.get("name", "")
        if not name:
            raise WorkbenchError(f"skill has no name: {entrypoint}")
        if name in skills:
            raise WorkbenchError(f"duplicate skill {name}: {skills[name]} and {directory}")
        skills[name] = directory
    return skills


def codex_agent_text(role_path: Path) -> str:
    metadata, body = parse_frontmatter(role_path)
    name = metadata["name"]
    description = metadata.get("description", "")
    permission_mode = metadata.get("permissionMode", "default")
    tools = {tool.strip() for tool in metadata.get("tools", "").split(",") if tool.strip()}
    read_only = permission_mode == "plan" or not ({"Edit", "Write"} & tools)

    lines = [
        f"name = {json.dumps(name)}",
        f"description = {json.dumps(description)}",
    ]
    if read_only:
        lines.append('sandbox_mode = "read-only"')
    effort = metadata.get("effort", "")
    if effort and effort != "inherit":
        lines.append(f"model_reasoning_effort = {json.dumps(effort)}")
    model = metadata.get("model", "")
    if model and model != "inherit":
        lines.append(f"model = {json.dumps(model)}")
    lines.extend(["", f"developer_instructions = {json.dumps(body)}", ""])
    return "\n".join(lines)


def flatten_profile(profile: dict) -> dict[str, str]:
    values: dict[str, str] = {}
    for section, section_values in profile.items():
        if not isinstance(section_values, dict):
            continue
        for key, value in section_values.items():
            if isinstance(value, (str, int, float, bool)):
                rendered = str(value)
                if isinstance(value, str) and ("path" in key or key in {"root", "repo", "nvim_config_dir"}):
                    rendered = str(expand_path(value))
                values[f"{section}_{key}"] = rendered
    values["workbench_root"] = str(ROOT)
    return values


def render_template(path: Path, profile: dict) -> str:
    try:
        rendered = string.Template(path.read_text(encoding="utf-8")).substitute(flatten_profile(profile))
    except KeyError as exc:
        raise WorkbenchError(f"{path} needs missing profile value: {exc.args[0]}") from exc
    return GENERATED_HEADER + rendered


def backup_name(target: Path) -> Path:
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    candidate = target.with_name(f"{target.name}.backup-{stamp}")
    counter = 1
    while candidate.exists() or candidate.is_symlink():
        candidate = target.with_name(f"{target.name}.backup-{stamp}-{counter}")
        counter += 1
    return candidate


def ensure_symlink(source: Path, target: Path, dry_run: bool) -> None:
    source = source.resolve()
    if target.is_symlink() and target.resolve() == source:
        print(f"ok      {target} -> {source}")
        return
    if target.exists() or target.is_symlink():
        backup = backup_name(target)
        print(f"backup  {target} -> {backup}")
        if not dry_run:
            target.rename(backup)
    print(f"link    {target} -> {source}")
    if not dry_run:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.symlink_to(source, target_is_directory=source.is_dir())


def write_managed(target: Path, content: str, dry_run: bool) -> None:
    if target.is_file() and target.read_text(encoding="utf-8") == content:
        print(f"ok      {target}")
        return
    if (target.exists() or target.is_symlink()) and not (
        target.is_file() and target.read_text(encoding="utf-8", errors="ignore").startswith(GENERATED_HEADER)
    ):
        backup = backup_name(target)
        print(f"backup  {target} -> {backup}")
        if not dry_run:
            target.rename(backup)
    print(f"write   {target}")
    if not dry_run:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8")


def render_tmuxp(profile: dict, dry_run: bool) -> None:
    destination = expand_path(profile["install"]["tmuxp_dir"])
    templates = [ROOT / "tmuxp" / "local-dev.yaml.tmpl"]
    if profile.get("remote", {}).get("enabled", False):
        templates.append(ROOT / "tmuxp" / "remote-dev.yaml.tmpl")
    for template in templates:
        output_name = template.name.removesuffix(".tmpl")
        write_managed(destination / output_name, render_template(template, profile), dry_run)


def validate(profile_path: Path | None = None) -> None:
    manifest = load_toml(ROOT / "workbench.toml")
    profile = load_toml(profile_path or EXAMPLE_PROFILE)
    roots = profile_roots(profile) if profile_path else [ROOT]
    external_skills = profile_skill_paths(profile) if profile_path else []
    roles = discover_roles(roots)
    skills = discover_skills(roots, external_skills)

    for name, path in roles.items():
        if not NAME_RE.fullmatch(name):
            raise WorkbenchError(f"invalid agent name {name!r} in {path}")
        if path.stem != name:
            raise WorkbenchError(f"agent filename must match name {name}: {path}")
        metadata, body = parse_frontmatter(path)
        if not metadata.get("description") or not body.strip():
            raise WorkbenchError(f"agent needs a description and body: {path}")
        tomllib.loads(codex_agent_text(path))

    for name, directory in skills.items():
        if not NAME_RE.fullmatch(name):
            raise WorkbenchError(f"invalid skill name {name!r}: {directory}")
        if directory.name != name and directory not in external_skills:
            raise WorkbenchError(f"skill folder must match name {name}: {directory}")
        metadata, body = parse_frontmatter(directory / "SKILL.md")
        if not metadata.get("description") or not body.strip():
            raise WorkbenchError(f"skill needs a description and body: {directory}")

    for script in sorted((ROOT / "bin").iterdir()):
        if not script.is_file():
            continue
        first_line = script.read_text(encoding="utf-8").splitlines()[0]
        if "bash" in first_line:
            subprocess.run(["bash", "-n", str(script)], check=True)
    py_compile.compile(str(ROOT / "bin" / "workbench"), doraise=True)

    for module in (ROOT / "lib").glob("*.py"):
        py_compile.compile(str(module), doraise=True)

    render_template(ROOT / "tmuxp" / "local-dev.yaml.tmpl", profile)
    remote_profile = json.loads(json.dumps(profile))
    remote_profile.setdefault("remote", {})["enabled"] = True
    render_template(ROOT / "tmuxp" / "remote-dev.yaml.tmpl", remote_profile)

    forbidden = manifest.get("safety", {}).get("public_forbidden_markers", [])
    public_paths = [
        ROOT / "README.md",
        ROOT / "AGENTS.md",
        ROOT / "agents",
        ROOT / "skills",
        ROOT / "tmux",
        ROOT / "tmuxp",
        ROOT / "docs",
        ROOT / "profiles" / "example.toml",
        ROOT / "bin" / "neo-help",
        ROOT / "bin" / "review-pr",
        ROOT / "bin" / "review-mr",
        ROOT / "bin" / "review-worktree",
        ROOT / "lib",
    ]
    for public_path in public_paths:
        files = [public_path] if public_path.is_file() else list(public_path.rglob("*"))
        for path in files:
            if not path.is_file():
                continue
            text = path.read_text(encoding="utf-8", errors="ignore")
            for marker in forbidden:
                if marker.lower() in text.lower():
                    raise WorkbenchError(f"public marker {marker!r} found in {path}")

    print(f"validated {len(roles)} agents, {len(skills)} skills, scripts, and tmuxp templates")


def install(profile_path: Path, dry_run: bool) -> None:
    validate(profile_path)
    profile = load_toml(profile_path)
    manifest = load_toml(ROOT / "workbench.toml")
    roots = profile_roots(profile)
    external_skills = profile_skill_paths(profile)

    bin_dir = expand_path(profile["install"]["bin_dir"])
    for command in manifest["install"]["commands"]:
        ensure_symlink(ROOT / "bin" / command, bin_dir / command, dry_run)

    claude_dir = expand_path(profile["install"]["claude_agents_dir"])
    codex_dir = expand_path(profile["install"]["codex_agents_dir"])
    generated_dir = Path.home() / ".local" / "share" / "dev-workspace" / "codex-agents"
    for name, role_path in discover_roles(roots).items():
        ensure_symlink(role_path, claude_dir / f"{name}.md", dry_run)
        generated = generated_dir / f"{name}.toml"
        write_managed(generated, codex_agent_text(role_path), dry_run)
        if not dry_run:
            ensure_symlink(generated, codex_dir / f"{name}.toml", False)
        else:
            print(f"link    {codex_dir / f'{name}.toml'} -> {generated}")

    claude_skills_dir = expand_path(profile["install"]["claude_skills_dir"])
    codex_skills_dir = expand_path(profile["install"]["codex_skills_dir"])
    for name, skill_dir in discover_skills(roots, external_skills).items():
        ensure_symlink(skill_dir, claude_skills_dir / name, dry_run)
        ensure_symlink(skill_dir, codex_skills_dir / name, dry_run)

    tmux_dir = Path.home() / ".config" / "tmux"
    ensure_symlink(ROOT / "tmux" / "common.conf", tmux_dir / "dev-workspace-common.conf", dry_run)
    ensure_symlink(ROOT / "tmux" / "remote.conf", tmux_dir / "dev-workspace-remote.conf", dry_run)
    render_tmuxp(profile, dry_run)

    if profile["install"].get("link_nvim", False):
        nvim_source = expand_path(profile["workspace"]["nvim_config_dir"])
        if not nvim_source.is_dir():
            raise WorkbenchError(f"Neovim config checkout does not exist: {nvim_source}")
        ensure_symlink(nvim_source, Path.home() / ".config" / "nvim", dry_run)

    print("dry run complete" if dry_run else "installation complete")
    if str(bin_dir) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"note: add {bin_dir} to PATH")


def doctor(profile_path: Path) -> None:
    manifest = load_toml(ROOT / "workbench.toml")
    profile = load_toml(profile_path)
    failures = 0
    for command in manifest["dependencies"]["required_commands"]:
        found = shutil.which(command)
        print(f"{'ok' if found else 'missing':7} {command}{f' -> {found}' if found else ''}")
        failures += int(found is None)
    for command in manifest["dependencies"]["optional_commands"]:
        found = shutil.which(command)
        print(f"{'ok' if found else 'optional':7} {command}{f' -> {found}' if found else ''}")

    nvim_dir = expand_path(profile["workspace"]["nvim_config_dir"])
    print(f"{'ok' if (nvim_dir / 'README.md').is_file() else 'missing':7} Neovim config {nvim_dir}")
    try:
        roles = discover_roles(profile_roots(profile))
        skills = discover_skills(profile_roots(profile), profile_skill_paths(profile))
        print(f"ok      {len(roles)} agent roles, {len(skills)} skills discoverable")
    except WorkbenchError as exc:
        failures += 1
        print(f"error   {exc}")
    if failures:
        raise WorkbenchError(f"doctor found {failures} required problem(s)")


def new_agent(args: argparse.Namespace) -> None:
    name = args.name
    if not NAME_RE.fullmatch(name):
        raise WorkbenchError("agent name must use 3-64 lowercase letters, digits, and hyphens")
    if not args.description.strip() or "\n" in args.description:
        raise WorkbenchError("agent description must be one non-empty line")
    role_path = ROOT / "agents" / "roles" / f"{name}.md"
    if role_path.exists():
        raise WorkbenchError(f"agent already exists: {role_path}")

    tools = "Read, Grep, Glob, Bash" if args.read_only else "Read, Grep, Glob, Bash, Edit, Write"
    permission = "plan" if args.read_only else "default"
    safety = (
        "Never edit files or change external state. Describe any required mutation for the operator."
        if args.read_only
        else "Preserve unrelated work and obtain explicit authorization before destructive or external actions."
    )
    role = f"""---
name: {name}
description: {json.dumps(args.description)}
tools: {tools}
permissionMode: {permission}
model: inherit
effort: high
---

# {name.replace('-', ' ').title()}

You are a specialist whose purpose is: {args.description}

## Boundaries

{safety}

Read repository instructions and relevant source material before acting. State
the exact scope, distinguish observations from inferences, and keep changes
focused on the requested outcome.

## Completion

Report the result, verification performed, remaining uncertainty, and any safe
next action.
"""
    role_path.write_text(role, encoding="utf-8")
    print(f"created {role_path}")

    if args.with_skill:
        skill_dir = ROOT / "skills" / name
        skill_dir.mkdir(parents=True, exist_ok=False)
        skill = f"""---
name: {name}
description: {json.dumps(args.description)}
---

# {name.replace('-', ' ').title()}

Use this workflow only for tasks matching the role's stated purpose.

1. Establish the requested outcome and applicable repository instructions.
2. Inspect the smallest set of source material needed to make a grounded
   decision.
3. Preserve the role's permission and safety boundaries.
4. Verify the observable result in proportion to its risk.
"""
        (skill_dir / "SKILL.md").write_text(skill, encoding="utf-8")
        print(f"created {skill_dir / 'SKILL.md'}")

    print("next: refine the role, then run bin/workbench validate")


def sync_remote(profile_path: Path, host: str, dry_run: bool) -> None:
    if not re.fullmatch(r"[A-Za-z0-9_.@-]+", host):
        raise WorkbenchError("remote host must be an SSH alias or user@host without shell syntax")
    profile = load_toml(profile_path)
    roots = profile_roots(profile)
    roles = discover_roles(roots)
    skills = discover_skills(roots, profile_skill_paths(profile))
    if dry_run:
        for name, path in roles.items():
            print(f"sync    {path} -> {host}:~/.claude/agents/{name}.md")
        for name, path in skills.items():
            print(f"sync    {path}/ -> {host}:~/.claude/skills/{name}/")
            print(f"sync    {path}/ -> {host}:~/.agents/skills/{name}/")
        print("dry run complete")
        return

    subprocess.run(
        ["ssh", host, "mkdir -p ~/.claude/agents ~/.claude/skills ~/.agents/skills"],
        check=True,
    )
    for name, path in roles.items():
        subprocess.run(["rsync", "-a", str(path), f"{host}:~/.claude/agents/{name}.md"], check=True)
    for name, path in skills.items():
        subprocess.run(["rsync", "-a", f"{path}/", f"{host}:~/.claude/skills/{name}/"], check=True)
        subprocess.run(["rsync", "-a", f"{path}/", f"{host}:~/.agents/skills/{name}/"], check=True)
    print(f"synchronized {len(roles)} agents and {len(skills)} skills to {host}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="workbench")
    subparsers = parser.add_subparsers(dest="command", required=True)

    for command in ("doctor", "install", "render"):
        subparser = subparsers.add_parser(command)
        subparser.add_argument("--profile")
        if command in {"install", "render"}:
            subparser.add_argument("--dry-run", action="store_true")

    validate_parser = subparsers.add_parser("validate")
    validate_parser.add_argument("--profile")

    agent_parser = subparsers.add_parser("agent")
    agent_subparsers = agent_parser.add_subparsers(dest="agent_command", required=True)
    new_parser = agent_subparsers.add_parser("new")
    new_parser.add_argument("name")
    new_parser.add_argument("--description", required=True)
    new_parser.add_argument("--read-only", action="store_true")
    new_parser.add_argument("--with-skill", action="store_true")

    sync_parser = subparsers.add_parser("sync-remote")
    sync_parser.add_argument("host")
    sync_parser.add_argument("--profile")
    sync_parser.add_argument("--dry-run", action="store_true")
    workspace_remote.add_parser(subparsers)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        if args.command == "validate":
            validate(expand_path(args.profile) if args.profile else None)
        elif args.command == "doctor":
            doctor(selected_profile(args.profile))
        elif args.command == "install":
            install(selected_profile(args.profile), args.dry_run)
        elif args.command == "render":
            profile = load_toml(selected_profile(args.profile))
            render_tmuxp(profile, args.dry_run)
        elif args.command == "agent" and args.agent_command == "new":
            new_agent(args)
        elif args.command == "remote":
            workspace_remote.run(load_toml(selected_profile(args.profile)), args)
        elif args.command == "sync-remote":
            sync_remote(selected_profile(args.profile), args.host, args.dry_run)
        return 0
    except (WorkbenchError, workspace_remote.RemoteError, KeyError, OSError, subprocess.CalledProcessError) as exc:
        print(f"workbench: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
